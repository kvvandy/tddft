#bf_path=/scratch/user/u.kw224068/dft2/mask_volkov_3d/test/data/Ng_6
gs_path=/scratch/group/p.phy240167.000/collision/ICD/Pyrrole_H2O/gs

# correct path to some needed files
pp_path=/scratch/group/p.phy240167.000/codes/input_data_dft/
bf_path=/scratch/group/p.phy240167.000/codes/input_data_dft/Ng_6/

#restart if RESTART file is present
restart_update_frequency=100
smart_restart_detect=true

xc_functional_mode=4

#self-interaction correction
#use_adsic=true

# read in the inital occupation from the file occ_time.inp
read_initial_occupation=true

run_type=24
continuation=true
tddft_type=2
td_data_output_frequency=10
orb_en_comp_output_frequency=10 
time_step=0.00075d0
N_time_steps=270000
ramp_time=0.5

temperature_ions=300
ion_velocity_init_seed=40
keep_all_restart_taylor=false

print_fragment_info=true
print_fragment_freq=40
fragment_dens_rad=1.5d0

move_atoms=true
move_all_atoms=true
atomic_movement_frequency=5
moldyn_output_level=5
moldyn_output_frequency=500
save_trajectory=true
trajectory_output_frequency=500


#Static external field
e_ext=0.d0

output_full_td_density=true
td_density_output_frequency=500
td_density_output_format=bov


cap_left1=-12
cap_right1=12
cap_left2=-11
cap_right2=11
cap_left3=-11
cap_right3=11
cap_parameter=0.4
save_cap=true

output_full_td_density=true
td_density_output_format=bov
large_file_format=binary
output_mr_density_slice=false
output_mr_orbital_charge=false
output_plot_time=false

output_inner_product=true
output_inner_product_frequency=50
