# This is an input file for doing laser ionization

#  The system starts out with atoms moving at random speeds

#



pp_path=/home/cjiang2/varga_dft_code_serial/input_files/

bf_path=/home/cjiang2/varga_dft_code_serial/input_files/Ng_6/

gs_path=../gs



run_type=24

continuation=true

tddft_type=2

td_data_output_frequency=10

orb_en_comp_output_frequency=10

time_step=0.001d0

N_time_steps=300000

ramp_time=0.5



# give the ions nonzero initial velocities

temperature_ions=300

ion_velocity_init_seed=1718


move_atoms=true

move_all_atoms=true

atomic_movement_frequency=5

moldyn_output_level=5

moldyn_output_frequency=500

save_trajectory=true

trajectory_output_frequency=500





#Static external field

e_ext=0.d0



output_full_td_density=true

td_density_output_frequency=500

td_density_output_format=bov



# setup for the CAP

cap_left1=-11

cap_right1=11

cap_left2=-11

cap_right2=11

cap_left3=-11

cap_right3=11

cap_parameter=0.4

save_cap=true





large_file_format=binary

output_mr_density_slice=false

output_mr_orbital_charge=false

output_plot_time=false



print_fragment_info=true

print_fragment_freq=20

fragment_dens_rad=1.5d0


e_laser1=7.5

laser_wavelength1=790

laser_envelope_type1=gaussian

laser_pulse_width1=6

laser_pulse_shift1=12

e_laser2=7.5

laser_wavelength2=790

laser_envelope_type2=gaussian

laser_pulse_width2=6

laser_pulse_shift2=12

e_laser3=7.5

laser_wavelength3=790

laser_envelope_type3=gaussian

laser_pulse_width3=6

laser_pulse_shift3=12

restart_update_frequency=500

smart_restart_detect=true

xc_functional_mode=5